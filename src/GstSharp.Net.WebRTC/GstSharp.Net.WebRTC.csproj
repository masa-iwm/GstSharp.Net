<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Gst.WebRTC</RootNamespace>
    <Description>GstWebRTC for GstSharp.Net: session descriptions, ICE, transports and data channels for webrtcbin.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../GstSharp.Net/GstSharp.Net.csproj" />

    <!-- The generated sources of this module name no GstSdp type: the gir
         mentions GstSDPMessage only in the field and the constructor parameter
         of GstWebRTCSessionDescription, and neither is emitted. The reference
         is here for the hand written session description glue, which takes and
         hands out Gst.Sdp.SDPMessage. -->
    <ProjectReference Include="../GstSharp.Net.Sdp/GstSharp.Net.Sdp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The ABI probes of the integration tests read the raw mirrors of this
         module, which are internal: nothing outside the binding has a reason
         to know the native layout of a record. -->
    <InternalsVisibleTo Include="GstSharp.IntegrationTests" />
  </ItemGroup>

</Project>
