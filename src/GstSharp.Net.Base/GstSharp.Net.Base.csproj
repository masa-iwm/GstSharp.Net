    <InternalsVisibleTo Include="GstSharp.IntegrationTests" />
    <InternalsVisibleTo Include="GstSharp.Net.App" />
    <InternalsVisibleTo Include="GstSharp.Net.Audio" />
    <InternalsVisibleTo Include="GstSharp.Net.Video" />
    <InternalsVisibleTo Include="GstSharp.Net.Pbutils" />
  </ItemGroup>

</Project>
