<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Gst.Base</RootNamespace>
    <Description>GstBase for GstSharp.Net: the base element classes, the Adapter and the typefind helpers.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../GstSharp.Net/GstSharp.Net.csproj" />
  </ItemGroup>

  <ItemGroup>
