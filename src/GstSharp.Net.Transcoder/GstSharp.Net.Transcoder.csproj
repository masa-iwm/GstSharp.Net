<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Gst.Transcoder</RootNamespace>
    <Description>GstTranscoder for GstSharp.Net: transcoding a media URI into another one against an encoding profile.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <!-- No version of this package is on nuget.org yet, so there is no
         baseline for the API compatibility gate to download and it fails the
         build while it looks for one. It stays off until the first release is
         published and the baseline version is bumped; remove this after the
         next patch release. -->
    <EnablePackageValidation>false</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../GstSharp.Net/GstSharp.Net.csproj" />

    <!-- gst_transcoder_new_full takes the encoding profile as an object rather
         than as the serialized string gst_transcoder_new parses, so the
         constructor of this module names Gst.Pbutils.EncodingProfile. -->
    <ProjectReference Include="../GstSharp.Net.Pbutils/GstSharp.Net.Pbutils.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The ABI probes of the integration tests read the raw mirrors of this
         module, which are internal: nothing outside the binding has a reason
         to know the native layout of a record. -->
    <InternalsVisibleTo Include="GstSharp.IntegrationTests" />
  </ItemGroup>

</Project>
