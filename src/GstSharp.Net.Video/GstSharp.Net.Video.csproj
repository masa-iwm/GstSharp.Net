<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Gst.Video</RootNamespace>
    <Description>GstVideo for GstSharp.Net: video formats, video info and the video metas.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../GstSharp.Net/GstSharp.Net.csproj" />
    <ProjectReference Include="../GstSharp.Net.Base/GstSharp.Net.Base.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The ABI probes of the integration tests read the raw mirrors of this
         module, which are internal: nothing outside the binding has a reason
         to know the native layout of a record. -->
    <InternalsVisibleTo Include="GstSharp.IntegrationTests" />
  </ItemGroup>

</Project>
