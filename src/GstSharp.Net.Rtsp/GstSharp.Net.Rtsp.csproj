<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Gst.Rtsp</RootNamespace>
    <Description>GstRtsp for GstSharp.Net: RTSP connections, messages, URLs and transports.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../GstSharp.Net/GstSharp.Net.csproj" />

    <!-- The RTSP extension interface parses a session description and sets a
         media up, so its methods take Gst.Sdp.SDPMessage and Gst.Sdp.SDPMedia. -->
    <ProjectReference Include="../GstSharp.Net.Sdp/GstSharp.Net.Sdp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The ABI probes of the integration tests read the raw mirrors of this
         module, which are internal: nothing outside the binding has a reason
         to know the native layout of a record. -->
    <InternalsVisibleTo Include="GstSharp.IntegrationTests" />

    <!-- The RTSP server binds messages, connections, URLs and transports of
         this module, and the generated code reaches their internal handles and
         FromNative factories directly. -->
    <InternalsVisibleTo Include="GstSharp.Net.RtspServer" />
  </ItemGroup>

</Project>
