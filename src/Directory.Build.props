<Project>

  <!-- MSBuild only auto-imports the nearest Directory.Build.props, so the
       repository-root file has to be imported explicitly from here. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup Label="Shipping libraries">
    <!-- Every shipping library must stay NativeAOT friendly. The netstandard2.0
         analyzer project turns this off again, because IsAotCompatible is only
         understood from net8.0 onwards. -->
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <IsPackable>true</IsPackable>

    <!-- The debugging symbols travel inside the assembly. The GitHub Packages
         feed has no symbol server, so a symbol package would help nobody
         there, and a consumer of the plain package would otherwise get stack
         traces without lines. The SDK's built-in source link plus the
         ContinuousIntegrationBuild switch the pack step passes make the
         embedded symbols step into sources once the repository is public. -->
    <DebugType>embedded</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup Label="Package validation">
    <!-- The mechanical half of the promise the README makes under "Status and
         versioning": from 1.28.1 on the public surface of a 1.28.x package only
         grows. Package validation is what holds the repository to it. `dotnet
         pack` restores the same package at the baseline version from nuget.org
         and compares what is about to be packed against what is already
         published: a public type or member that disappeared, or that kept its
         name and changed its shape, fails the pack with a CP#### error naming
         it. A member that was only added says nothing, which is the point -
         additive is the whole allowance.

         Written here beside IsPackable rather than in each project, so that a
         module added later is covered by construction and cannot be the one
         that ships a removal. It reaches exactly the twelve published packages:
         the SDK conditions both the baseline download and the check itself on
         IsPackable, and the analyzer project answers no to that - it ships
         inside GstSharp.Net and has no package of its own to compare against.

         The baseline is the newest published 1.28.x, moved forward once
         nuget.org serves each release - it enters every CI job's restore as a
         PackageDownload, so it can only name a version that is really there.
         Following the newest release is what puts each release's additions
         under the same guard: against 1.28.1 alone, everything 1.28.2 added
         could vanish unnoticed. 1.28.0 is never the baseline - it predates the
         promise and is unlisted for it, and comparing against it would report
         the deliberate re-projection of that first week as a breaking change
         forever. 1.30.0 is the release that is allowed to break compilation,
         and the first 1.30 package starts the anchor over. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.28.2</PackageValidationBaselineVersion>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <VersionPrefix>1.28.3</VersionPrefix>
    <Authors>GstSharp.Net contributors</Authors>
    <Company>GstSharp.Net</Company>
    <Product>GstSharp.Net</Product>
    <!-- The fallback for a project that says nothing more about itself; every
         shipping project overrides it with the one sentence that names the
         library it binds, so a search result tells the twelve apart. -->
    <Description>NativeAOT-first .NET bindings for GStreamer 1.28.</Description>
    <PackageLicenseExpression>LGPL-2.1-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/masa-iwm/GstSharp.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/masa-iwm/GstSharp.Net.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>gstreamer;multimedia;native;aot;interop</PackageTags>
    <Copyright>Copyright (c) GstSharp.Net contributors</Copyright>

    <!-- The whole set is one product with one story, so every package shows the
         repository README rather than a per-package stub nobody keeps current.
         The file has to be packed as well, which the item below does; naming it
         without packing it is NU5039. The icon follows the same rule - one
         image beside the README for all twelve, packed by the item below, and
         naming it without packing it is NU5046. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup Label="Package metadata">
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
