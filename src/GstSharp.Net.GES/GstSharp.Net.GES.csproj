<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>GES</RootNamespace>
    <Description>GStreamer Editing Services for GstSharp.Net: timelines, layers, clips and the assets behind them.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../GstSharp.Net/GstSharp.Net.csproj" />

    <!-- A discoverer runs over every URI asset the editing services load, so
         the asset surface hands out Gst.Pbutils.DiscovererInfo and its stream
         information, and rendering a timeline takes an encoding profile. -->
    <ProjectReference Include="../GstSharp.Net.Pbutils/GstSharp.Net.Pbutils.csproj" />

    <!-- GESPipeline previews a timeline in a window of the application, so it
         implements Gst.Video.IVideoOverlay. -->
    <ProjectReference Include="../GstSharp.Net.Video/GstSharp.Net.Video.csproj" />

    <!-- The ABI probes read the generated class struct registry of the module,
         and the layout tests read the mirrors themselves; both are internal,
         because a class struct is a measurement and not a public surface. -->
    <InternalsVisibleTo Include="GstSharp.IntegrationTests" />
  </ItemGroup>

</Project>
