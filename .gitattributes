# LF everywhere, matching .editorconfig (end_of_line = lf).
* text=auto eol=lf

*.cs      text eol=lf
*.gir     text eol=lf
*.json    text eol=lf
*.csproj  text eol=lf
*.props   text eol=lf
*.targets text eol=lf
*.md      text eol=lf
*.yml     text eol=lf

# The solution is .slnx; `dotnet sln migrate` writes it with CRLF, so the rule
# is spelled out rather than left to the default.
*.slnx    text eol=lf

*.png binary
*.dll binary
