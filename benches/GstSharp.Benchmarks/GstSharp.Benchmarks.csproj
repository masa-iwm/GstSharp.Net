<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>GstSharp.Benchmarks</RootNamespace>

    <!-- The harness ships with nothing: it is built by every CI job and packed
         by none, like the samples and the tests. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <!-- The entry point of the binding is the type GstSharp in the global
         namespace, and this assembly declares a namespace of the same name, so
         the type is only reachable through an alias. The reference stays in the
         global alias as well, so that every other type is used unqualified. -->
    <ProjectReference Include="../../src/GstSharp.Net/GstSharp.Net.csproj" Aliases="global,gstsharp" />

    <!-- The managed identity filter of the trampoline benchmark derives from
         GstBaseTransform. -->
    <ProjectReference Include="../../src/GstSharp.Net.Base/GstSharp.Net.Base.csproj" />

    <!-- The harness is a consumer of the binding like the samples are, so it
         builds with the analyzers the package ships. ReferenceOutputAssembly
         keeps the analyzer out of the compilation references, OutputItemType
         makes the build run the rules, and PrivateAssets keeps it out of the
         package dependencies. One project needs no Directory.Build.props of
         its own for this. -->
    <ProjectReference Include="../../src/GstSharp.Net.Analyzers/GstSharp.Net.Analyzers.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" PrivateAssets="all" />
  </ItemGroup>

</Project>
