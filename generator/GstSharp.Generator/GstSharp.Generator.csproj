<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>GstSharp.Generator</RootNamespace>
    <AssemblyName>GstSharp.Generator</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The generator is an executable; its types stay internal and the test
         project reaches them through this. -->
    <InternalsVisibleTo Include="GstSharp.Generator.Tests" />
  </ItemGroup>

</Project>
