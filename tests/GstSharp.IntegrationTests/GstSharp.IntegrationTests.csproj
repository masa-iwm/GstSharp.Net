<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>GstSharp.IntegrationTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!-- The entry point of the binding is the type GstSharp in the global
         namespace, and this assembly declares a namespace of the same name, so
         the type is only reachable through an alias. The reference stays in the
         global alias as well, so that every other type is used unqualified. -->
    <ProjectReference Include="../../src/GstSharp.Net/GstSharp.Net.csproj" Aliases="global,gstsharp" />
    <ProjectReference Include="../../src/GstSharp.Net.App/GstSharp.Net.App.csproj" />
    <ProjectReference Include="../../src/GstSharp.Net.Base/GstSharp.Net.Base.csproj" />
    <ProjectReference Include="../../src/GstSharp.Net.Sdp/GstSharp.Net.Sdp.csproj" />
    <ProjectReference Include="../../src/GstSharp.Net.WebRTC/GstSharp.Net.WebRTC.csproj" />
    <ProjectReference Include="../../src/GstSharp.Net.Net/GstSharp.Net.Net.csproj" />

    <!-- Referenced, but never called into: the module sweep of
         GstSharp.Initialize is what has to put their types into the registry,
         and a test that called one of them would register it by hand and prove
         nothing. ModuleRegistrationTests is the test that measures it, and it
         names no type of any module for the same reason; the modules above are
         called into by their own tests, which is why it has to be run on its
         own to be discriminating. -->
    <ProjectReference Include="../../src/GstSharp.Net.Video/GstSharp.Net.Video.csproj" />
    <ProjectReference Include="../../src/GstSharp.Net.Audio/GstSharp.Net.Audio.csproj" />
    <ProjectReference Include="../../src/GstSharp.Net.Pbutils/GstSharp.Net.Pbutils.csproj" />
  </ItemGroup>

</Project>
